# ============================================
# Konfigurasi Server Batu Merapi Backend
# ============================================
# Salin file ini menjadi ".env" dan isi nilainya.
# JANGAN PERNAH commit file .env asli ke Git!

NODE_ENV=production

# Port server Express (default: 3000)
PORT=3000

# URL proyek Supabase (dari Settings > API di dashboard Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co

# Gunakan SERVICE_ROLE KEY untuk backend server (bukan anon key) agar aman dengan RLS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Secret key untuk menandatangani token JWT admin (minimal 32 karakter acak kriptografis)
JWT_SECRET=ganti_dengan_secret_acak_minimal_64_karakter_hex
